# Copy to .env for machine-local overrides. Gitignored.
#
# Environment variables outrank both TOML config files. Nested keys use a double
# underscore: HEDWIG_<SECTION>__<KEY>. See docs/02 §7.
#
# Secrets do not belong here. HEDWIG reads secrets from the OS keychain only.

# HEDWIG_RUNTIME__ENVIRONMENT=development
# HEDWIG_RUNTIME__DATA_DIR=~/.hedwig

# HEDWIG_API__HOST=127.0.0.1
# HEDWIG_API__PORT=8730

# HEDWIG_LOGGING__LEVEL=debug
# HEDWIG_LOGGING__FORMAT=console
# HEDWIG_LOGGING__FILE_ENABLED=true

# Frontend (Vite). Only VITE_-prefixed variables reach the browser.
# VITE_HEDWIG_API=http://127.0.0.1:8730

# Local configuration and secrets
.env
.env.local
config/hedwig.local.toml

# HEDWIG runtime data — never in version control. This is the user's memory.
data/
*.db
*.db-wal
*.db-shm

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Avatar models. A VRM carries its own licence in its metadata, and committing someone else's
# model makes this repository its redistributor (docs/28 §5.1). Place yours here; it stays local.
frontend/public/avatars/*
!frontend/public/avatars/README.md
